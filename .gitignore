# ==========================================
# Slotify Git Ignore
# Excludes private info, runtime data & artifacts
# ==========================================

# Environment variables & secrets (allow .env.example)
.env
.env.local
.env.development
.env.test
.env.production
.env.*
!.env.example
*.env
*.pem
*.key
secrets/

# Database files & SQLite runtime storage
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Internal documents, personal reports & presentations
doc/
*.docx
*.pptx
*.xlsx
*.pdf

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# PyInstaller & build distributions
build/
dist/
*.spec

# Virtual environments
env/
venv/
myenv/
.venv/
ENV/
env.bak/
venv.bak/

# Operating System files
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Desktop.ini

# Editor & IDE configurations
.vscode/
.idea/
*.swp
*.swo
*~
